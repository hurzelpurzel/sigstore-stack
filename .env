# Development-only defaults. Change these before exposing the stack anywhere.
COMPOSE_PROJECT_NAME=sigstore-stack

# Password protecting the encrypted Fulcio CA private key.
FULCIO_CA_PASSWORD=fulcio-dev-password
# Password protecting the encrypted Rekor log signing key.
REKOR_SIGNER_PASSWORD=rekor-dev-password

# Keycloak bootstrap administrator.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Demo realm / user imported by Keycloak (see config/keycloak/realm-sigstore.json).
KEYCLOAK_REALM=sigstore
KEYCLOAK_DEMO_USER=alice
KEYCLOAK_DEMO_PASSWORD=alice

# URLs advertised to clients running on the host (cosign, browser).
FULCIO_URL=http://localhost:5555
REKOR_URL=http://localhost:3000
CTLOG_URL=http://localhost:6962
KEYCLOAK_URL=http://keycloak.localhost:8080
KEYCLOAK_ISSUER=http://keycloak.localhost:8080/realms/sigstore
REKOR_UI_URL=http://localhost:8081
REGISTRY=localhost:5001

# MySQL used by Trillian (Rekor's backing log) and Rekor's search index.
DB_NAME=sigstore
DB_USER=sigstore
DB_PASSWORD=sigstore-dev-password
DB_ROOT_PASSWORD=root-dev-password
